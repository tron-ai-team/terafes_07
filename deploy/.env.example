# Copy to /etc/tron-ai/tron-ai.env on the Ubuntu core server.
# chmod 640 /etc/tron-ai/tron-ai.env
# NEVER commit a filled copy.
#
# Generate secrets on the server, for example:
#   openssl rand -base64 48
#   openssl rand -hex 32

# ── Image / compose ──────────────────────────────────────────────────────────
TRON_BACKEND_IMAGE=ghcr.io/tron-ai-team/terafes_07/tron-ai-backend:latest
TRON_BACKEND_HOST_PORT=18080
TRON_BACKEND_MEM_LIMIT=1280m
TRON_BACKEND_CPUS=1.5
TRON_GOTENBERG_MEM_LIMIT=1024m
TRON_GOTENBERG_CPUS=1.0
TRON_MYSQL_MEM_LIMIT=768m
TRON_MYSQL_CPUS=0.75
JAVA_OPTS=-Xms256m -Xmx768m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError

# ── Spring ───────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0

# ── Dedicated Docker MySQL (NOT the host MySQL used by other apps) ────────────
# Compose sets DB_HOST=mysql on the internal network.
DB_NAME=tron_ai
DB_USERNAME=tronai
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_POOL_MAX=5
DB_POOL_MIN=1

# ── Public URLs (traonai.tech) ───────────────────────────────────────────────
TRON_FRONTEND_URL=https://traonai.tech
TRON_PUBLIC_API_URL=https://api.traonai.tech
CORS_ALLOWED_ORIGINS=https://traonai.tech,https://api.traonai.tech
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.traonai.tech/login/oauth2/code/google

# ── Gotenberg (compose overrides GOTENBERG_URL to http://gotenberg:3000) ─────
TRON_PDF_ENGINE=gotenberg
TRON_PDF_ALLOW_LOCAL_LIBREOFFICE=false

# ── RabbitMQ (phase-1: disabled; enable only after a broker exists) ───────────
TRON_RABBITMQ_ENABLED=false
RABBITMQ_LISTENER_ENABLED=false

# ── AI node (private LAN — later integration; not required for backend start) ─
OLLAMA_BASE_URL=http://AI_NODE_PRIVATE_IP:11434
OLLAMA_MODEL=qwen3:8b
STT_BASE_URL=
VOICEVOX_BASE_URL=

# ── MinIO (optional — local filesystem volume fallback is used if unavailable)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=tron-ai-private

# ── Cloud AI fallback (default off) ──────────────────────────────────────────
CLOUD_AI_ENABLED=false
CLOUD_AI_PROVIDER=
CLOUD_AI_API_KEY=
CLOUD_AI_BASE_URL=
CLOUD_AI_MODEL_FAST=
CLOUD_AI_MODEL_QUALITY=

# ── AI Gateway / research (inject via server env or Infisical — never bake in) ─
GROQ_API_KEY=
GROQ_MODEL_SMART=openai/gpt-oss-120b
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
OPENROUTER_API_KEY_1=
MISTRAL_API_KEY=
GEMINI_API_KEY_1=
TRON_AI_CV_CLOUD_ENABLED=false
TRON_AI_COMPANY_CLOUD_ENABLED=true
INFISICAL_ENABLED=false
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=production
