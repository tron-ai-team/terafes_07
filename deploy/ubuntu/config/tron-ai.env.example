# Copy to /etc/tron-ai/tron-ai.env and replace every empty secret.
# chmod 640 /etc/tron-ai/tron-ai.env
# Do not commit the filled file.
#
# Preferred runtime: Docker Compose (see deploy/compose.prod.yml).

# ── Image pin (updated by deploy-release.sh) ─────────────────────────────────
TRON_BACKEND_IMAGE=ghcr.io/tron-ai-team/terafes_07/tron-ai-backend:latest
TRON_BACKEND_HOST_PORT=18080
TRON_BACKEND_MEM_LIMIT=1280m
TRON_GOTENBERG_MEM_LIMIT=1024m
TRON_MYSQL_MEM_LIMIT=768m
JAVA_OPTS=-Xms256m -Xmx768m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0

# Dedicated Compose MySQL credentials (required). Compose forces DB_HOST=mysql.
DB_NAME=tron_ai
DB_USERNAME=tronai
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_POOL_MAX=5

JWT_SECRET=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax

TRON_FRONTEND_URL=https://traonai.tech
TRON_PUBLIC_API_URL=https://api.traonai.tech
CORS_ALLOWED_ORIGINS=https://traonai.tech,https://api.traonai.tech

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.traonai.tech/login/oauth2/code/google

GOTENBERG_URL=http://gotenberg:3000
TRON_PDF_ENGINE=gotenberg
TRON_PDF_ALLOW_LOCAL_LIBREOFFICE=false

TRON_RABBITMQ_ENABLED=false
RABBITMQ_LISTENER_ENABLED=false

# Later: private AI node. Not required for core stack startup.
OLLAMA_BASE_URL=http://AI_NODE_PRIVATE_IP:11434
OLLAMA_MODEL=qwen3:8b
STT_BASE_URL=
VOICEVOX_BASE_URL=

MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=tron-ai-private

CLOUD_AI_ENABLED=false
CLOUD_AI_PROVIDER=
CLOUD_AI_API_KEY=
CLOUD_AI_BASE_URL=
CLOUD_AI_MODEL_FAST=
CLOUD_AI_MODEL_QUALITY=
