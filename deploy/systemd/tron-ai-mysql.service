[Unit]
Description=Restricted TRON relay to existing loopback MySQL TCP
Requires=tron-ai-mysql.socket
After=mysql.service

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --connections-max=32 127.0.0.1:3306
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=32M
CPUQuota=10%
Restart=on-failure
