# Copy to /etc/tron-ai/tron-ai.env on the Ubuntu core server.
# chmod 640 /etc/tron-ai/tron-ai.env
# NEVER commit a filled copy.

# ── Image / compose ──────────────────────────────────────────────────────────
TRON_BACKEND_IMAGE=ghcr.io/OWNER/REPO/tron-ai-backend:sha-REPLACE
TRON_BACKEND_HOST_PORT=18080
TRON_BACKEND_MEM_LIMIT=1280m
TRON_GOTENBERG_MEM_LIMIT=1024m
JAVA_OPTS=-Xms256m -Xmx768m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError

# ── Spring ───────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0

# ── MySQL (existing server instance — NEW schema + least-privilege user) ─────
# From inside Docker, use host.docker.internal (compose sets this).
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=tron_ai
DB_USERNAME=tronai
DB_PASSWORD=replace-with-database-password

# ── Public URLs (replace YOUR_DOMAIN.tech after purchase) ────────────────────
TRON_FRONTEND_URL=https://YOUR_DOMAIN.tech
TRON_PUBLIC_API_URL=https://YOUR_DOMAIN.tech
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN.tech
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN.tech/login/oauth2/code/google

# ── Gotenberg (compose overrides GOTENBERG_URL to http://gotenberg:3000) ─────
TRON_PDF_ENGINE=gotenberg
TRON_PDF_ALLOW_LOCAL_LIBREOFFICE=false

# ── AI node (private LAN — never publish these ports) ────────────────────────
OLLAMA_BASE_URL=http://AI_NODE_PRIVATE_IP:11434
OLLAMA_MODEL=qwen3:8b
STT_BASE_URL=http://AI_NODE_PRIVATE_IP:8091
VOICEVOX_BASE_URL=http://AI_NODE_PRIVATE_IP:50021

# ── Optional RabbitMQ (existing broker or install separately) ────────────────
# If no broker: set SPRING_AUTOCONFIGURE_EXCLUDE as below.
RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=replace-with-rabbitmq-user
RABBITMQ_PASSWORD=replace-with-rabbitmq-password
# SPRING_AUTOCONFIGURE_EXCLUDE=org.springframework.boot.autoconfigure.amqp.RabbitAutoConfiguration

# ── MinIO (optional — local filesystem fallback is used if unavailable) ──────
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=tron-ai-private

# ── Cloud AI fallback (default off) ──────────────────────────────────────────
CLOUD_AI_ENABLED=false
CLOUD_AI_PROVIDER=
CLOUD_AI_API_KEY=
CLOUD_AI_BASE_URL=
CLOUD_AI_MODEL_FAST=
CLOUD_AI_MODEL_QUALITY=
