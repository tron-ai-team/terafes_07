      "CompanyResearchRequest": {
        "properties": {
          "company_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Company Name"
          },
          "target_role": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Target Role"
          },
          "website_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Website Url"
          }
        },
        "type": "object",
        "required": [
          "company_name",
          "target_role"
        ],
        "title": "CompanyResearchRequest"
      },
      "CompanyResearchResponse": {
        "properties": {
          "company_name": {
            "type": "string",
            "title": "Company Name"
          },
          "target_role": {
            "type": "string",
            "title": "Target Role"
          },
          "search": {
            "$ref": "#/components/schemas/SearchStatus"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceDocument"
            },
            "type": "array",
            "title": "Sources"
          },
          "report_ja": {
            "type": "string",
            "title": "Report Ja"
          },
          "verified_facts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Verified Facts"
          },
          "missing_information": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Information"
          }
        },
        "type": "object",
        "required": [
          "company_name",
          "target_role",
          "search",
          "sources",
          "report_ja",
          "verified_facts",
          "missing_information"
        ],
        "title": "CompanyResearchResponse"
      },
      "CvUploadResponse": {
        "properties": {
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "page_count": {
            "type": "integer",
            "title": "Page Count"
          },
          "text_characters": {
            "type": "integer",
            "title": "Text Characters"
          },
          "education": {
            "items": {
              "$ref": "#/components/schemas/EducationItem"
            },
            "type": "array",
            "title": "Education"
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Skills"
          },
          "work_experience": {
            "items": {
              "$ref": "#/components/schemas/ExperienceItem"
            },
            "type": "array",
            "title": "Work Experience"
          },
          "extraction_notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Extraction Notes"
          }
        },
        "type": "object",
        "required": [
          "filename",
          "page_count",
          "text_characters",
          "education",
          "skills",
          "work_experience",
          "extraction_notes"
        ],
        "title": "CvUploadResponse"
      },
      "EducationItem": {
        "properties": {
          "school": {
            "type": "string",
            "title": "School",
            "default": ""
          },
          "period": {
            "type": "string",
            "title": "Period",
            "default": ""
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": ""
          }
        },
        "type": "object",
        "title": "EducationItem"
      },
      "ExperienceItem": {
        "properties": {
          "organization": {
            "type": "string",
            "title": "Organization",
            "default": ""
          },
          "role": {
            "type": "string",
            "title": "Role",
            "default": ""
          },
          "period": {
            "type": "string",
            "title": "Period",
            "default": ""
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": ""
          }
        },
        "type": "object",
        "title": "ExperienceItem"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "ollama": {
            "type": "string",
            "enum": [
              "reachable",
              "unreachable"
            ],
            "title": "Ollama"
          }
        },
        "type": "object",
        "required": [
          "status",
          "ollama"
        ],
        "title": "HealthResponse"
      },
      "InterviewAnswerRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
