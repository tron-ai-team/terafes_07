# Copy to /etc/tron-ai/tron-ai.env and replace every placeholder.
# chmod 640 /etc/tron-ai/tron-ai.env
# Do not commit the filled file.
#
# Preferred runtime: Docker Compose (see deploy/compose.prod.yml).
# This file is also the env_file for the backend container.

# ── Image pin (updated by deploy-release.sh) ─────────────────────────────────
TRON_BACKEND_IMAGE=ghcr.io/OWNER/REPO/tron-ai-backend:latest
TRON_BACKEND_HOST_PORT=18080
TRON_BACKEND_MEM_LIMIT=1280m
TRON_GOTENBERG_MEM_LIMIT=1024m
JAVA_OPTS=-Xms256m -Xmx768m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0

DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=tron_ai
DB_USERNAME=tronai
DB_PASSWORD=replace-with-database-password
DB_POOL_MAX=5

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax

# Purchased .tech domain — replace placeholders; do not invent a domain.
TRON_FRONTEND_URL=https://YOUR_DOMAIN.tech
TRON_PUBLIC_API_URL=https://YOUR_DOMAIN.tech
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN.tech

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN.tech/login/oauth2/code/google

GOTENBERG_URL=http://gotenberg:3000
TRON_PDF_ENGINE=gotenberg
TRON_PDF_ALLOW_LOCAL_LIBREOFFICE=false

# Private AI node. Example shape only.
# RTX Tailscale Serve (private). Example for exhibition activation:
# OLLAMA_BASE_URL=https://nayem-asus-tuf-gaming-a15-fa507nvr-fa507nvr.tail63f4de.ts.net
# OLLAMA_CONNECT_IP=100.95.30.39
# OLLAMA_TLS_SERVER_NAME=nayem-asus-tuf-gaming-a15-fa507nvr-fa507nvr.tail63f4de.ts.net
# OLLAMA_OVERRIDE_HOST=localhost:11434
# TRON_AI_RTX_SMART_MODE=false
# TRON_AI_RTX_SMART_MODEL=qwen3.5:9b-q4_K_M
# GTX Tailscale Serve (private Fast Mode). Keep Ollama on localhost; use Serve HTTPS.
# GTX_OLLAMA_BASE_URL=https://thushan-ai.tail63f4de.ts.net
# GTX_OLLAMA_CONNECT_IP=100.109.33.81
# GTX_OLLAMA_TLS_SERVER_NAME=thushan-ai.tail63f4de.ts.net
# GTX_OLLAMA_OVERRIDE_HOST=localhost:11434
# TRON_AI_GTX_FAST_MODE=false
# TRON_AI_GTX_FAST_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://AI_NODE_PRIVATE_IP:11434
OLLAMA_MODEL=qwen3:8b
# Leave STT_BASE_URL / VOICEVOX empty until RTX AI node; cloud uses GROQ_API_KEY.
# STT_BASE_URL=http://AI_NODE_PRIVATE_IP:8091
STT_BASE_URL=
STT_GROQ_ENABLED=true
STT_GROQ_MODEL=whisper-large-v3-turbo
# VOICEVOX_BASE_URL=http://AI_NODE_PRIVATE_IP:50021
VOICEVOX_BASE_URL=
TTS_GROQ_ENABLED=true
TTS_GROQ_MODEL_ENGLISH=canopylabs/orpheus-v1-english
TTS_GROQ_VOICE_ENGLISH=autumn

MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=tron-ai-private

RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=replace-with-rabbitmq-user
RABBITMQ_PASSWORD=replace-with-rabbitmq-password
RABBITMQ_LISTENER_ENABLED=false
# If RabbitMQ is not installed, also set:
# SPRING_AUTOCONFIGURE_EXCLUDE=org.springframework.boot.autoconfigure.amqp.RabbitAutoConfiguration

CLOUD_AI_ENABLED=false
CLOUD_AI_PROVIDER=
CLOUD_AI_API_KEY=
CLOUD_AI_BASE_URL=
CLOUD_AI_MODEL_FAST=
CLOUD_AI_MODEL_QUALITY=

# Cloud LLM / Whisper STT / English Orpheus TTS (never commit real values)
GROQ_API_KEY=
OPENROUTER_API_KEY_1=
GEMINI_API_KEY_1=
