# Install as /etc/tron-ai/production.env mode 600. Do not source as shell code.
# Staging: separate file, DB_NAME=tron_ai_staging, DB_USERNAME=tronai_staging.
DB_HOST=mysql-proxy
DB_PORT=3306
TRON_MYSQL_SOCKET_DIR=/run/tron-ai-mysql
TRON_MYSQL_SOCKET_GID=REPLACE_WITH_RELAY_GROUP_GID
DB_NAME=tron_ai
DB_USERNAME=tronai_prod
DB_PASSWORD=REPLACE_WITH_GENERATED_SECRET
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET
TRON_FRONTEND_URL=http://127.0.0.1:18081
TRON_PUBLIC_API_URL=http://127.0.0.1:18081
CORS_ALLOWED_ORIGINS=http://127.0.0.1:18081
# False ONLY for localhost validation. Require true with HTTPS before public exposure.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
# RTX Tailscale Serve (private). Keep Ollama bound to localhost on the RTX host.
# OLLAMA_BASE_URL=https://nayem-asus-tuf-gaming-a15-fa507nvr-fa507nvr.tail63f4de.ts.net
# OLLAMA_CONNECT_IP=100.95.30.39
# OLLAMA_TLS_SERVER_NAME=nayem-asus-tuf-gaming-a15-fa507nvr-fa507nvr.tail63f4de.ts.net
# OLLAMA_OVERRIDE_HOST=localhost:11434
# TRON_AI_RTX_SMART_MODE=false
# TRON_AI_RTX_SMART_MODEL=qwen3.5:9b-q4_K_M
# GTX Tailscale Serve (private). Keep Ollama bound to localhost on the GTX host.
# GTX_OLLAMA_BASE_URL=https://thushan-ai.tail63f4de.ts.net
# GTX_OLLAMA_CONNECT_IP=100.109.33.81
# GTX_OLLAMA_TLS_SERVER_NAME=thushan-ai.tail63f4de.ts.net
# GTX_OLLAMA_OVERRIDE_HOST=localhost:11434
# TRON_AI_GTX_FAST_MODE=false
# TRON_AI_GTX_FAST_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://AI_NODE_PRIVATE_IP:11434
TRON_OLLAMA_HEALTH_URL=http://AI_NODE_PRIVATE_IP:11434/api/tags
STT_BASE_URL=
VOICEVOX_BASE_URL=
TRON_GOTENBERG_IMAGE=gotenberg/gotenberg@sha256:REPLACE_WITH_VERIFIED_DIGEST
TRON_FRONTEND_IMAGE=nginx@sha256:REPLACE_WITH_VERIFIED_DIGEST
TRON_MYSQL_PROXY_IMAGE=alpine/socat@sha256:REPLACE_WITH_VERIFIED_DIGEST
DB_POOL_MAX=5
DB_POOL_MIN=1
RABBITMQ_LISTENER_ENABLED=false
TRON_BACKEND_CPUS=1.0
TRON_GOTENBERG_CPUS=0.5
JAVA_OPTS=-Xms128m -Xmx640m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError
