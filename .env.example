# ==============================================================================
# TRON AI — root environment variable names (placeholders only)
# Copy values into backend/backend-spring/.env or OS env / Infisical.
# NEVER commit real secrets. Keys must never appear in React bundles.
# Full reference: docs/AI_PROVIDER_CONFIGURATION.md
# ==============================================================================

# Database / auth / Ollama — see backend/backend-spring/.env.example
DB_PASSWORD=
JWT_SECRET=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# AI Gateway LLM providers
GROQ_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
OPENROUTER_API_KEY_1=
MISTRAL_API_KEY=
GEMINI_API_KEY_1=

# Backend Intelligence V1 (placeholders only — defaults keep search stubbed)
TRON_WEB_SEARCH_V1_ENABLED=false
TRON_SEARCH_SEARXNG_ENABLED=false
TRON_SEARCH_SEARXNG_BASE_URL=http://127.0.0.1:8888
TRON_SEARCH_GROQ_BROWSER_ENABLED=false
TRON_SEARCH_OPENROUTER_TOOL_ENABLED=false
TRON_SEARCH_SERPER_ENABLED=false
SERPER_API_KEY=
TRON_SEARCH_SERPER_DAILY_MAX_CALLS=0
TRON_SEARCH_LOCAL_PAID_FALLBACK_ENABLED=false
# Primary approved TTS (Gemini Algenib robotic). Keep disabled until key + opt-in.
GEMINI_API_KEY=
TTS_GEMINI_ENABLED=false
TTS_GEMINI_MODEL=gemini-3.8-flash-lite-tts
TTS_GEMINI_VOICE=Algenib
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Privacy / routing
TRON_AI_CV_CLOUD_ENABLED=false
TRON_AI_COMPANY_CLOUD_ENABLED=true
TRON_AI_PREFER_GROQ_SMART=true
GROQ_MODEL_SMART=openai/gpt-oss-120b

# Infisical (optional; leave disabled for local)
INFISICAL_ENABLED=false
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=development
