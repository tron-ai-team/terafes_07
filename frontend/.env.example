# TRON AI frontend — public Vite env only (never put secrets in VITE_* vars)
#
# Site:  https://tronai.tech
# API:   https://api.tronai.tech
#
# --- Local Vite (classroom / LAN) ---
# Empty = same-origin; Vite proxies /api → 127.0.0.1:8080
VITE_CORE_API_URL=
VITE_LEGACY_API_URL=

# Local-only direct Spring (skips Vite proxy; breaks remote LAN browsers):
# VITE_CORE_API_URL=http://localhost:8080
# VITE_LEGACY_API_URL=http://localhost:8080

# --- Vercel production (Root Directory = frontend) ---
# Set these in the Vercel project Environment Variables (Production):
#   VITE_CORE_API_URL=https://api.tronai.tech
#   VITE_LEGACY_API_URL=https://api.tronai.tech
# If unset at build time, production builds default to https://api.tronai.tech
# (see src/config/api.ts). Do NOT leave production pointed at localhost.
