# ==============================================================================
# TRON AI Spring Boot — Environment Variables Reference
# Copy this file to .env and fill in real values.
# NEVER commit a .env file with real secrets to version control.
# ==============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
# Server binds to 127.0.0.1:8080 by default (set in application.yml)
# Override if needed:
# SERVER_PORT=8080
# SERVER_ADDRESS=127.0.0.1

# ── Spring Profile ────────────────────────────────────────────────────────────
# Use 'local' for local dev overrides (application-local.yml)
# SPRING_PROFILES_ACTIVE=local

# ── Database (Step 2 — MySQL 8) ────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tron_ai
DB_USERNAME=tronai
DB_PASSWORD=your_database_password_here

# ── API Security (Step 2 — not yet enforced) ──────────────────────────────────
# API_KEY=changeme_strong_random_key
# Equivalent to the X-API-Key header used by the FastAPI backend.

# ── Ollama (Step 3 — Local AI Model) ──────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=60

# ── Model Manager (Step 4 — Default Model) ───────────────────────────────────
TRON_DEFAULT_MODEL=qwen3-8b

# ── Speech-to-Text & Text-to-Speech ─────────────────────────────────────────
# Local faster-whisper / VOICEVOX (RTX AI node). Empty base URL → cloud STT via GROQ_API_KEY.
STT_BASE_URL=http://127.0.0.1:8091
STT_PREFER_LOCAL=true
STT_GROQ_ENABLED=true
STT_GROQ_MODEL=whisper-large-v3-turbo
STT_GROQ_TIMEOUT_SECONDS=60
VOICEVOX_BASE_URL=http://127.0.0.1:50021
# Primary approved TTS: Gemini Algenib robotic (EN+JA). Disabled until opted in.
TTS_GEMINI_ENABLED=false
GEMINI_API_KEY=
TTS_GEMINI_MODEL=gemini-3.8-flash-lite-tts
TTS_GEMINI_VOICE=Algenib
TTS_GEMINI_STYLE=Low, resonant pitch; calm cinematic AI with subtle synthetic resonance, crisp diction and natural conversational pacing.
# Groq Orpheus TTS is English-only (not Japanese). JA uses Gemini / VOICEVOX or browser fallback.
# Fallback bilingual robotic TTS (EN+JA). Disabled until ELEVENLABS_API_KEY is set.
TTS_ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
# Adam (premade, free-plan API OK). Library voices like Danny require a paid plan.
TTS_ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
TTS_ELEVENLABS_MODEL_ID=eleven_multilingual_v2
TTS_ELEVENLABS_OUTPUT_FORMAT=pcm_24000
TTS_ROBOTIC_ENABLED=true

TTS_GROQ_ENABLED=true
TTS_GROQ_MODEL_ENGLISH=canopylabs/orpheus-v1-english
TTS_GROQ_VOICE_ENGLISH=troy
TTS_GROQ_TIMEOUT_SECONDS=30
TRON_VOICE_CLOUD_PREFER_SMART=true
TRON_VOICE_MAX_TOKENS_FAST=256
TRON_VOICE_MAX_TOKENS_QUALITY=512

# ── Security & Authentication (Mega Mission 2) ───────────────────────────────
JWT_SECRET=your_minimum_256_bit_secret_key_here_for_hmac_sha256
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# ── CORS Configuration ───────────────────────────────────────────────────────
# Production example: https://your-project.vercel.app
# Do not use * when cookies are enabled.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# ── AI node (private LAN). Core calls these. Do not publish the ports. ──────
# OLLAMA_BASE_URL=http://192.168.x.20:11434
# STT_BASE_URL=http://192.168.x.20:8091
# VOICEVOX_BASE_URL=http://192.168.x.20:50021

# ── Cloud fallback (default OFF). Key stays in the environment only. ────────
CLOUD_AI_ENABLED=false
CLOUD_AI_PROVIDER=
CLOUD_AI_API_KEY=
CLOUD_AI_BASE_URL=
CLOUD_AI_MODEL_FAST=
CLOUD_AI_MODEL_QUALITY=

# ── AI Gateway cloud providers (backend-only; never put these in React) ─────
GROQ_API_KEY=
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_SMART=openai/gpt-oss-120b
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
MISTRAL_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
TRON_AI_PREFER_GROQ_SMART=true
# Personal CV cloud opt-in (default false). Per-request allowCloud=true also works.
TRON_AI_CV_CLOUD_ENABLED=false
TRON_AI_COMPANY_CLOUD_ENABLED=true
TRON_AI_INTERVIEW_CLOUD_ENABLED=true
# Optional local secrets file (KEY=VALUE). Env vars win when already set.
# TRON_AI_SECRETS_FILE=%LOCALAPPDATA%\TRON\secrets\ai-providers.env

# ── Web research tools (Company Advisor; distinct from LLM providers) ───────
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=basic
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
TRON_RESEARCH_COMPANY_ADVISOR=true

# ── Backend Intelligence V1 web search (ALL default OFF — no behavior change) ─
# Production (future owner enablement only; do not set on prod without approval):
#   TRON_WEB_SEARCH_V1_ENABLED=true
#   TRON_SEARCH_SEARXNG_ENABLED=true
#   TRON_SEARCH_SEARXNG_BASE_URL=http://tron-searxng:8080
TRON_WEB_SEARCH_V1_ENABLED=false
TRON_SEARCH_SEARXNG_ENABLED=false
TRON_SEARCH_SEARXNG_BASE_URL=http://127.0.0.1:8888
TRON_SEARCH_SEARXNG_TIMEOUT_MS=6000
TRON_SEARCH_SEARXNG_MAX_RESULTS=5
TRON_SEARCH_GROQ_BROWSER_ENABLED=false
TRON_SEARCH_OPENROUTER_TOOL_ENABLED=false
TRON_SEARCH_SERPER_ENABLED=false
SERPER_API_KEY=
TRON_SEARCH_SERPER_DAILY_MAX_CALLS=0
# Paid Serper requires an ABSOLUTE ledger on persistent storage (host mount/volume).
# Relative paths fail-closed so container replacement cannot reset spend.
# Example (owner-approved only): TRON_SEARCH_SERPER_BUDGET_LEDGER=/var/lib/tron-ai/serper-daily-budget.ledger
TRON_SEARCH_SERPER_BUDGET_LEDGER=data/serper-daily-budget.ledger
TRON_SEARCH_LOCAL_PAID_FALLBACK_ENABLED=false
TRON_SEARCH_MAX_QUERIES_FAST=1
TRON_SEARCH_MAX_QUERIES_SMART=2
TRON_SEARCH_CACHE_TTL_SECONDS=300
TRON_SEARCH_MAX_RESULTS_FAST=3
TRON_SEARCH_MAX_RESULTS_SMART=5

# ── Infisical (optional; disabled by default — do not require for local) ────
INFISICAL_ENABLED=false
INFISICAL_SITE_URL=https://app.infisical.com
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=development
INFISICAL_SECRET_PATH=/

# ── Gotenberg PDF ────────────────────────────────────────────────────────────
GOTENBERG_URL=http://127.0.0.1:3000

# ── MinIO Private Object Storage ─────────────────────────────────────────────
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET=tron-ai-private

# ── RabbitMQ Event Queue ─────────────────────────────────────────────────────
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your_rabbitmq_username_here
RABBITMQ_PASSWORD=your_rabbitmq_password_here


